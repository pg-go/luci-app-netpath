#!/bin/sh
# NetPath standalone web: second uhttpd instance, dashboard only.
#
# Creates (once, idempotent) config uhttpd 'netpath':
#   listen_http 0.0.0.0:8080 and [::]:8080, home /www/netpath,
#   cgi_prefix /cgi-bin, interpreter .sh=/bin/sh, rfc1918_filter 0.
# No lua_prefix, no ubus_prefix, no realm/config: this instance serves
# only the static dashboard in /www/netpath and its read-only CGI API.
# It cannot serve LuCI, /ubus, or any other page, and it has no login:
# anyone who can reach port 8080 can see the dashboard. The firewall
# decides who that is: by default OpenWrt WAN input is REJECT, so
# 8080 is LAN-only unless the user adds a wan->device rule for it.
# Run again safely: an existing 'netpath' section is left alone.

[ -x /usr/sbin/uci ] || exit 0
uci get uhttpd.netpath >/dev/null 2>&1 && exit 0

uci set uhttpd.netpath=uhttpd
uci add_list uhttpd.netpath.listen_http='0.0.0.0:8080'
uci add_list uhttpd.netpath.listen_http='[::]:8080'
uci set uhttpd.netpath.home='/www/netpath'
uci set uhttpd.netpath.cgi_prefix='/cgi-bin'
uci add_list uhttpd.netpath.interpreter='.sh=/bin/sh'
uci set uhttpd.netpath.max_requests='3'
uci set uhttpd.netpath.rfc1918_filter='0'
uci commit uhttpd

# The CGI script is shipped 644 (git loses +x): make it executable,
# and the interpreter mapping above is the fallback if this fails.
[ -f /www/netpath/cgi-bin/api.sh ] && chmod 755 /www/netpath/cgi-bin/api.sh 2>/dev/null

/etc/init.d/uhttpd reload 2>/dev/null || /etc/init.d/uhttpd restart 2>/dev/null || true
exit 0
